generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PRODUCTION_COORDINATOR
  DEPARTMENT_HEAD
  CONTRACTOR           // Reelarc filmmakers who log in and submit timecards
}

enum PaymentTerms {
  NET_30
  NET_45
  NET_60
}

enum TimecardStatus {
  DRAFT
  SUBMITTED            // Contractor submitted their timecard
  UNDER_REVIEW
  APPROVED
  RETURNED
  SUBMITTED_TO_PAYROLL
  PROCESSED
  PAID
  VOIDED
}

enum ReviewAction {
  REVIEWED
  APPROVED
  BYPASS_TO_FINAL
  TO_REVIEW
  RETURNED_TO_CONTRACTOR
}

enum PayType {
  WORKED
  NOT_WORKED
  HOLIDAY
  SICK
  UNPAID_DAY
  TRAVEL
  PREP
  WRAP
}

// ─── USERS & CONTRACTORS ─────────────────────────────

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String?      // for contractor login
  name          String
  role          UserRole     @default(CONTRACTOR)
  jobTitle      String?
  unionLocal    String?
  department    String?
  phone         String?
  paymentTerms  PaymentTerms @default(NET_30)
  hourlyRate    Float?       // default rate for this contractor
  dayRate       Float?       // alternative: flat day rate
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  timecards          Timecard[]
  reviews            TimecardReview[]
  productionMembers  ProductionMember[]

  @@map("users")
}

// ─── PRODUCTIONS (Projects/Shows) ────────────────────

model Production {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timecards  Timecard[]
  members    ProductionMember[]
  scenes     Scene[]

  @@map("productions")
}

model ProductionMember {
  id           String       @id @default(cuid())
  productionId String
  userId       String
  role         UserRole
  department   String?
  jobTitle     String?
  rateType     String?      // "Hourly", "Day Rate", "Flat Rate"
  hourlyRate   Float?
  dayRate      Float?
  paymentTerms PaymentTerms @default(NET_30)
  createdAt    DateTime     @default(now())

  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productionId, userId])
  @@map("production_members")
}

// ─── SCENE CODES ─────────────────────────────────────
// Scene codes are per-production and used to track costs by scene

model Scene {
  id           String   @id @default(cuid())
  productionId String
  code         String   // e.g. "SC-101", "INT-OFFICE-DAY"
  description  String?  // e.g. "Interior Office - Day - Dialog scene"
  estimatedBudget Float?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  production   Production         @relation(fields: [productionId], references: [id], onDelete: Cascade)
  timecardScenes TimecardEntryScene[]

  @@unique([productionId, code])
  @@map("scenes")
}

// ─── TIMECARDS ───────────────────────────────────────

model Timecard {
  id             String          @id @default(cuid())
  contractorId   String          // the filmmaker submitting this
  productionId   String
  weekEnding     DateTime
  status         TimecardStatus  @default(DRAFT)
  workLocation   String?         @default("Studio")
  jobTitle       String?
  department     String?

  // Pay info
  hourlyRate     Float?
  dayRate        Float?
  paymentTerms   PaymentTerms    @default(NET_30)

  // Calculated totals
  totalHours     Float           @default(0)
  totalStraight  Float           @default(0)
  totalOT15      Float           @default(0)
  totalOT2       Float           @default(0)
  totalAllowances Float          @default(0)
  totalPay       Float           @default(0)

  // Payment tracking
  paymentDueDate DateTime?
  paidDate       DateTime?

  // Comments
  contractorNotes String?        // notes from the filmmaker
  adminNotes      String?        // notes from Reelarc admin
  payrollNotes    String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  contractor     User            @relation(fields: [contractorId], references: [id])
  production     Production      @relation(fields: [productionId], references: [id])
  entries        TimecardEntry[]
  allowances     TimecardAllowance[]
  reviews        TimecardReview[]

  @@map("timecards")
}

model TimecardEntry {
  id          String   @id @default(cuid())
  timecardId  String
  date        DateTime
  dayOfWeek   String
  payType     PayType  @default(NOT_WORKED)

  // Time tracking
  timeIn      String?
  meal1Out    String?
  meal1In     String?
  meal2Out    String?
  meal2In     String?
  timeOut     String?

  // Hours breakdown
  straightTime Float   @default(0)
  ot15         Float   @default(0)
  ot2          Float   @default(0)
  totalHours   Float   @default(0)

  // Scene codes for this day's work
  scenes       TimecardEntryScene[]

  timecard     Timecard @relation(fields: [timecardId], references: [id], onDelete: Cascade)

  @@map("timecard_entries")
}

// Junction table: each day can have multiple scenes, each scene tracks hours
model TimecardEntryScene {
  id              String  @id @default(cuid())
  timecardEntryId String
  sceneId         String
  hours           Float   @default(0) // hours spent on this scene
  notes           String?

  timecardEntry   TimecardEntry @relation(fields: [timecardEntryId], references: [id], onDelete: Cascade)
  scene           Scene         @relation(fields: [sceneId], references: [id])

  @@unique([timecardEntryId, sceneId])
  @@map("timecard_entry_scenes")
}

model TimecardAllowance {
  id          String  @id @default(cuid())
  timecardId  String
  type        String  // Kit Rental, Mileage, Per Diem, Equipment, etc.
  rate        Float?
  quantity    Float   @default(0)
  amount      Float   @default(0)
  isTaxable   Boolean @default(false)

  timecard    Timecard @relation(fields: [timecardId], references: [id], onDelete: Cascade)

  @@map("timecard_allowances")
}

model TimecardReview {
  id          String       @id @default(cuid())
  timecardId  String
  reviewerId  String
  action      ReviewAction
  comment     String?
  createdAt   DateTime     @default(now())

  timecard    Timecard     @relation(fields: [timecardId], references: [id], onDelete: Cascade)
  reviewer    User         @relation(fields: [reviewerId], references: [id])

  @@map("timecard_reviews")
}
